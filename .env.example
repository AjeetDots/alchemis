# Copy to .env and set to control which DB the app uses (no other code change needed).
# development = local DB (from app_options.xml <development>; in Docker host is "db")
# aws         = live RDS (from app_options.xml <aws>)
ALCHEMIS_ENV=development

# When running locally (not in Docker), override DB host/port so the app does not try to reach RDS.
# Omit these in Docker (host "db" is used) or on live (aws env uses app_options.xml).
# ALCHEMIS_DB_HOST=127.0.0.1
# ALCHEMIS_DB_PORT=3306
